# Copy to .env for local use. Never commit credentials.
APP_ORIGIN=http://localhost:5173
PORT=3001
HOST=127.0.0.1
# Local development defaults to data/campus.sqlite.
# Production requires a PostgreSQL connection and HTTPS APP_ORIGIN.
# DATABASE_URL=postgresql://campus:password@localhost:5432/campus
# NODE_ENV=production
# TRUST_PROXY_HOPS=1
# SMTP_URL=smtps://username:password@mail.example.com:465
# MAIL_FROM=Campus Studio <no-reply@example.com>
APK_BUILDS_ENABLED=false
ARTIFACT_DIR=artifacts
# Worker only; keep signing keys out of the API container.
# ANDROID_HOME=/opt/android-sdk
# JAVA_HOME=/opt/java/openjdk
# GRADLE_BIN=/opt/gradle/bin/gradle
# ANDROID_KEYSTORE=/run/secrets/campus-release.jks
# ANDROID_KEY_ALIAS=campus
# ANDROID_STORE_PASSWORD=from-secret-manager
# ANDROID_KEY_PASSWORD=from-secret-manager
